# Copy this file to .env and fill in your Supabase project's values.
# Both are safe to expose in the frontend bundle — only the anon key is used,
# never the service role key. Row Level Security enforces access control.
#
# If these are left unset (or malformed), the app falls back to guest-only mode
# automatically — gameplay never depends on Supabase being reachable.
#
# The frontend enforces no password rules (any non-empty password is accepted).
# Supabase itself enforces a server-side minimum password length (6 by default);
# change it in the dashboard under Authentication > Sign In / Providers >
# Minimum password length if you want to allow shorter ones such as "0000".

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
