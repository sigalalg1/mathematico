  "vocabulary": {
    "gameName": "Coordinate Vocabulary",
    "gameDescription": "Learn the key words, fast",
    "newTerm": "New term",
    "terms": {
      "coordinateSystem": {
        "term": "Coordinate system",
        "definition": "Two axes that meet to show location",
        "riddle": "I'm two number lines that cross. What am I?",
        "recallPrompt": "What's a coordinate system?"
      },
      "xAxis": {
        "term": "X-axis",
        "definition": "The horizontal axis",
        "riddle": "I run left and right. Which axis am I?",
        "recallPrompt": "Where's the X-axis?"
      },
      "yAxis": {
        "term": "Y-axis",
        "definition": "The vertical axis",
        "riddle": "I run up and down. Which axis am I?",
        "recallPrompt": "Where's the Y-axis?"
      },
      "horizontal": {
        "term": "Horizontal",
        "definition": "Side to side",
        "riddle": "I go side to side. What am I?",
        "recallPrompt": "What's horizontal?"
      },
      "vertical": {
        "term": "Vertical",
        "definition": "Up and down",
        "riddle": "I go up and down. What am I?",
        "recallPrompt": "What's vertical?"
      },
      "origin": {
        "term": "Origin",
        "definition": "Where the axes meet",
        "riddle": "I'm where the two axes meet. Who am I?",
        "recallPrompt": "Where's the origin?"
      },
      "point": {
        "term": "Point",
        "definition": "A location on the plane",
        "riddle": "I'm a location on the plane. What am I?",
        "recallPrompt": "What's a point?"
      },
      "pointCoordinates": {
        "term": "Coordinates of a point",
        "definition": "The numbers that locate a point",
        "riddle": "I'm the numbers that say where a point is. What am I?",
        "recallPrompt": "What are a point's coordinates?"
      },
      "xCoordinate": {
        "term": "X-coordinate",
        "definition": "The first number in the pair",
        "riddle": "I'm the first number in the pair. What am I?",
        "recallPrompt": "What's the X-coordinate?"
      },
      "yCoordinate": {
        "term": "Y-coordinate",
        "definition": "The second number in the pair",
        "riddle": "I'm the second number in the pair. What am I?",
        "recallPrompt": "What's the Y-coordinate?"
      },
      "orderedPair": {
        "term": "Ordered pair",
        "definition": "Two numbers written (x, y)",
        "riddle": "I'm two numbers written in order. What am I?",
        "recallPrompt": "What's an ordered pair?"
      },
      "quadrant": {
        "term": "Quadrant",
        "definition": "One of 4 regions made by the axes",
        "riddle": "I'm one of 4 regions on the plane. What am I?",
        "recallPrompt": "What's a quadrant?"
      }
    },
    "prompts": {
      "clickXAxis": "Where's the X-axis?",
