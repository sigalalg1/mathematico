      "yAxis": {
        "term": "Y-axis",
        "definition": "The vertical axis",
        "riddle": "I run up and down. Which axis am I?",
        "recallPrompt": "Where's the Y-axis?"
      },
      "horizontal": {
        "term": "Horizontal",
        "definition": "Side to side",
        "riddle": "I go side to side. What am I?",
        "recallPrompt": "What's horizontal?"
